{
    "name": "froxel-math",
    "version": "0.0.5",
    "description": "Froxel Math Library",
    "type": "module",
    "module": "dist/froxel-math.m.js",
    "types": "dist/froxel-math.d.ts",
    "scripts": {
        "test": "mocha",
        "tsdoc": "dts-bundle-generator --no-banner --disable-symlinks-following -o dist/froxel-math.d.ts src/main.ts",
        "build-core": "/dev/opt/wasi-sdk/bin/clang++ -I/dev/usr-include -nostdlib -nostartfiles -flto -Wl,--lto-O3 -Wl,--shared-memory -Wl,--import-memory -Wl,--initial-memory=1048576 -Wl,--max-memory=2147483648 -Wl,--allow-undefined -Wl,--export-dynamic -Wl,--no-check-features -Wl,--no-entry   src/vec2.cpp src/vec3.cpp src/vec4.cpp src/mat3.cpp src/mat4.cpp src/rect.cpp -o src/froxel-math.wasm",
        "wat": "wasm2wat --enable-thread src/froxel-math.wasm -o src/froxel-math.wat",
        "build": "parcel build --no-cache --target module",
        "all": "pnpm build-core && pnpm build && pnpm tsdoc"
    },
    "targets": {
        "module": {
            "source": "./src/main.ts",
            "optimize": true
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rsthn/froxel.git",
        "directory": "packages/froxel-math"
    },
    "author": "RedStar Technologies",
    "license": "Apache-2.0",
    "files": [
        "LICENSE",
        "README.md",
        "dist/"
    ],
    "devDependencies": {
        "@parcel/core": "^2.16.4",
        "@parcel/optimizer-data-url": "^2.16.4",
        "@parcel/transformer-inline-string": "^2.16.4",
        "chai": "^4.5.0",
        "chai-almost": "^1.0.1",
        "dts-bundle-generator": "^9.5.1",
        "mocha": "^10.8.2",
        "parcel": "^2.16.4",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "asyl": "^1.0.4",
        "atob": "^2.1.2",
        "base64-js": "^1.5.1",
        "node-fetch": "^3.3.2"
    }
}
